+"""Finite controller-owned criteria; semantic materiality remains a model judgment."""
+
+import hashlib
+import json
+from dataclasses import dataclass
+
+CORE_CRITERIA = (
+    ("core:technical_support", "Technical mechanisms and factual claims have adequate retained support."),
+    ("core:interpretation", "Outcome interpretations distinguish legitimate behavior from boundary violations."),
+    ("core:operational_sufficiency", "The requested method can be followed with explicit necessary prerequisites and controls."),
+    ("core:attribution", "Attribution accurately describes the retained sources and their limitations."),
+    ("core:restrictions", "The method complies with supplied restrictions and document policies."),
+)
+
+
+@dataclass(frozen=True)
+class ReviewContract:
+    payload: str
+    identifier: str
+    criterion_ids: frozenset[str]
+
+    @classmethod
+    def freeze(cls, requirements):
+        criteria = [{"id": key, "obligation": value, "origin": "shared_review_policy"}
+                    for key, value in CORE_CRITERIA]
+        criteria += [{"id": f"requirement:{row.id}", "obligation": row.description,
+                      "kind": row.kind, "origin": "validated_request", "requirement_id": row.id}
+                     for row in requirements]
+        payload = json.dumps({"acceptance_criteria": criteria}, ensure_ascii=False, sort_keys=True)
+        return cls(payload, hashlib.sha256(payload.encode()).hexdigest(), frozenset(row["id"] for row in criteria))
+
+    def render(self):
+        return (
+            f"Frozen acceptance contract sha256={self.identifier}\n{self.payload}\n"
+            "Only these criteria can justify a blocker. Identify material impact on the advertised method; "
+            "optional elaboration belongs in suggestions. New claims introduced by the draft can violate "
+            "existing criteria; do not invent new mandatory deliverables or silently broaden scope.\n"
+        )
