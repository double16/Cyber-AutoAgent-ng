# Cyber-AutoAgent Environment Configuration Template
# Copy this file to .env and customize for your environment

# RECOMMENDATION: keep the .env file lean by focusing on AWS_* access credentials and
# potentially remote stores (if you use them) and otherwise rely on the agent default values
# or modify them via the config.py

# ==============================================================================
# MODEL PROVIDER CONFIGURATION
# ==============================================================================

# Choose your model provider: 'bedrock' (AWS Bedrock), 'ollama' (Local), or 'litellm' (Universal)
# Default: bedrock
# CYBER_AGENT_PROVIDER=bedrock

# ==============================================================================
# AWS BEDROCK CONFIGURATION (Direct or via LiteLLM)
# ==============================================================================

# AWS Credentials for Bedrock access
# Required for bedrock provider - use either standard credentials OR bearer token
# Option 1: Standard AWS credentials
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Option 2: AWS Bedrock API key (bearer token)
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token

AWS_REGION=us-east-1

# Override default LLM model
# Default: global.anthropic.claude-opus-4-5-20251101-v1:0
# CYBER_AGENT_LLM_MODEL=global.anthropic.claude-opus-4-5-20251101-v1:0

# Override default embedding model
# Default: amazon.titan-embed-text-v2:0
# CYBER_AGENT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Override evaluation model
# Default: us.anthropic.claude-sonnet-4-5-20250929-v1:0
# CYBER_AGENT_EVALUATION_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# RAGAS_EVALUATOR_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Override swarm model
# Default: us.anthropic.claude-sonnet-4-5-20250929-v1:0
# CYBER_AGENT_SWARM_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ==============================================================================
# LITELLM CONFIGURATION (Universal Provider)
# ==============================================================================

# LiteLLM supports 100+ model providers via unified interface.
# Model format: provider/model-name (e.g., bedrock/..., openai/..., xai/grok-4-latest)

# Example: X.AI Grok 4 for reasoning with Titan embeddings handled by Bedrock
# CYBER_AGENT_PROVIDER=litellm
# CYBER_AGENT_LLM_MODEL=xai/grok-4-latest
# XAI_API_KEY=your_xai_api_key
# CYBER_AGENT_EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# OPENROUTER_API_KEY=...

# Example: Gemini via LiteLLM (requires google-genai dependency)
# CYBER_AGENT_LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key

# Example: OpenAI via LiteLLM
# CYBER_AGENT_LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=your_openai_api_key

# ==============================================================================
# OLLAMA CONFIGURATION (Local Provider)
# ==============================================================================

# Ollama server host
# Default: auto-detected (localhost or host.docker.internal)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_TIMEOUT=120

# Stop a task executor after this many calls violate active failure-recovery policy
# CYBER_TOOL_RECOVERY_MAX_POLICY_VIOLATIONS=2
# CYBER_TOOL_RECOVERY_MAX_CORRECTIONS=2

# Allow this many corrected create_tasks calls after the task creator's initial rejected call
# CYBER_TASK_CREATOR_MAX_CORRECTIONS=6
# CYBER_TASK_ACCEPTANCE_MAX_CORRECTIONS=2
# Allow bounded recovery when endpoint acceptance has only non-route-specific evidence
# CYBER_ENDPOINT_EVIDENCE_MAX_CORRECTIONS=1

# Override default LLM model for local mode
# Default: llama3.2:3b
# CYBER_AGENT_LLM_MODEL=llama3.2:3b

# Override default embedding model for local mode
# Default: mxbai-embed-large:latest
# CYBER_AGENT_EMBEDDING_MODEL=mxbai-embed-large:latest

# ==============================================================================
# MEMORY SYSTEM CONFIGURATION
# ==============================================================================

# Query only this operation (default), or all operations for the same target.
# CYBER_MEMORY_MODE=operation

# Local Qdrant persists in ${CYBER_AGENT_OUTPUT_DIR:-./outputs}/qdrant by default.
# Set a URL to use a Qdrant service instead.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_COLLECTION=cyber_autoagent_memories

# ==============================================================================
# OUTPUT DIRECTORY CONFIGURATION
# ==============================================================================

# Base directory for all output artifacts
# Default: ./outputs (relative to project root)
# CYBER_AGENT_OUTPUT_DIR=/custom/outputs

# Absolute path to a local SecLists checkout or package installation. When unset, common install locations are used.
# CYBER_SECLISTS_DIR=/usr/share/seclists

# ==============================================================================
# TOOL EXECUTION SAFETY
# ==============================================================================

# Reuse matching results when an exact tool-call cycle repeats this many times, then gracefully stop the current
# agent if it continues the cycle after receiving recovery guidance. Set to 0 to disable; otherwise use at least 2.
# CYBER_TOOL_REPEAT_THRESHOLD=3

# Maximum exact tool-call cycle length tracked by the repeat guard. Must be at least 1.
# CYBER_TOOL_REPEAT_MAX_CYCLE_LENGTH=8

# ==============================================================================
# WORKFLOW CONFIGURATION
# ==============================================================================

# Maximum plan critic reviews during initial plan creation. Each rejected review adds one revision model call.
# Default: 3 (set to 0 to disable plan critique)
# CYBER_WORKFLOW_PLAN_REFINEMENT_ITERATIONS=3

# Maximum critic reviews while building each task execution prompt. Each rejected review with another review
# remaining adds one revision model call.
# Default: 2 (set to 0 to disable task prompt critique)
# CYBER_WORKFLOW_TASK_PROMPT_REFINEMENT_ITERATIONS=2

# Maximum normal task-executor passes. A task evaluator "done" decision stops the cycle immediately.
# Default: 3 (minimum: 1)
# CYBER_WORKFLOW_TASK_EXECUTION_CYCLES=3

# Additional executor passes allowed for actionable task-evaluator partial-failure feedback after valid acceptance.
# Default: 1 (set to 0 to finalize evaluator feedback without a correction pass)
# CYBER_TASK_EVALUATOR_MAX_CORRECTIONS=1

# Maximum actor/critic refinement cycles for each generated report section. Each rejected critic review feeds its
# feedback into another actor invocation. Two cycles allow up to three actor calls and two critic calls.
# Default: 2 (set to 0 to disable report critique)
# CYBER_REPORT_REFINEMENT_CYCLES=2

# Taxonomy catalog used to validate report CWE and MITRE ATT&CK mappings. A bundled snapshot is
# always available; an optional URL may serve a normalized catalog JSON with `cwe` and `attack` lists.
# CYBER_TAXONOMY_CACHE_DIR=/var/cache/cyber-autoagent
# CYBER_TAXONOMY_REFRESH=true
# CYBER_TAXONOMY_REFRESH_DAYS=30
# CYBER_TAXONOMY_OFFLINE=false
# CYBER_TAXONOMY_CATALOG_URL=https://your-catalog-host/taxonomy_catalog.json
# Refresh manually with: uv run python -m modules.config.taxonomy_refresh

# Maximum read-only artifact calls available to each evaluator or report agent invocation.
# Default: 4 (minimum: 1)
# CYBER_WORKFLOW_ARTIFACT_READ_LIMIT=4

# Shared upper bound applied when operation coverage is incomplete or a hard budget limit terminates the operation.
# Natural task, phase, and budget-feasibility penalties are applied before this ceiling.
# Default: 0.99 (range: 0.0-1.0)
# CYBER_INCOMPLETE_HEALTH_CAP=0.99

# ==============================================================================
# OBSERVABILITY & MONITORING
# ==============================================================================

# Enable/disable observability tracing
# Default: true
# ENABLE_OBSERVABILITY=true

# Langfuse configuration for observability
# LANGFUSE_HOST is auto-configured by Docker Compose - only set for custom instances
# LANGFUSE_HOST=http://your-custom-langfuse:3000
LANGFUSE_PUBLIC_KEY=cyber-public
LANGFUSE_SECRET_KEY=cyber-secret

# Langfuse security settings (for production)
# LANGFUSE_ENCRYPTION_KEY=your-32-char-hex-key
# LANGFUSE_SALT=your-16-char-hex-salt
# LANGFUSE_ADMIN_PASSWORD=your-strong-password

# ==============================================================================
# PROMPT MANAGEMENT (LANGFUSE)
# ==============================================================================

# Enable Langfuse prompt management for dynamic prompt updates
# Default: true (prompts are auto-created on first run)
ENABLE_LANGFUSE_PROMPTS=true

# Langfuse prompt label to use (production, staging, dev)
# Default: production
LANGFUSE_PROMPT_LABEL=production

# Cache TTL for prompts in seconds
# Default: 300 (5 minutes)
LANGFUSE_PROMPT_CACHE_TTL=300

# ==============================================================================
# EVALUATION SYSTEM
# ==============================================================================

# Enable automatic evaluation after operations
# Default: false
# ENABLE_AUTO_EVALUATION=true
# EVAL_RUBRIC_ENABLED=true

# ==============================================================================
# MODEL RATE LIMITING
# ==============================================================================

# CYBER_RATE_LIMIT_TOKENS_PER_MIN=150000
# CYBER_RATE_LIMIT_REQ_PER_MIN=10
# CYBER_RATE_LIMIT_MAX_CONCURRENT=4

# ==============================================================================
# DEVELOPMENT & DEBUGGING
# ==============================================================================

# Development mode
# Default: false
# DEV=true

# Allow raw model-provider requests, full prompts, and tool schemas in debug logs.
# WARNING: These diagnostics may contain credentials, cookies, tokens, or target data.
# This has an effect only when verbose/debug logging is also enabled.
# Default: false
# CYBER_UNSAFE_DIAGNOSTIC_LOGGING=false

# Bypass tool consent prompts
# Default: false (prompts enabled)
# BYPASS_TOOL_CONSENT=true

# Enable heap monitoring for debugging
# Default: 1
# CYBER_HEAP_MONITOR_AUTOSTART=0

# ==============================================================================
# EXAMPLE CONFIGURATIONS
# ==============================================================================

# Example 1: Local development with Ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CONTEXT_LENGTH=32768
# CYBER_AGENT_OUTPUT_DIR=./outputs
# ENABLE_OBSERVABILITY=true

# Example 2: Remote production with AWS Bedrock
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=us-east-1
# CYBER_AGENT_OUTPUT_DIR=/app/outputs
# ENABLE_AUTO_EVALUATION=true
# QDRANT_URL=https://your-qdrant-service.example
# QDRANT_API_KEY=your_qdrant_api_key

# Example 3: Container deployment
# CYBER_AGENT_OUTPUT_DIR=/app/outputs
# ENABLE_OBSERVABILITY=true
