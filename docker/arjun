#!/usr/bin/env bash
set -e

# Find original binary
REAL_BIN=""
if [ -x "$(dirname "$0")/arjun.orig" ]; then
    REAL_BIN="$(dirname "$0")/arjun.orig"
elif command -v arjun.orig >/dev/null 2>&1; then
    REAL_BIN="$(command -v arjun.orig)"
elif [ -x "/usr/local/bin/arjun.orig" ]; then
    REAL_BIN="/usr/local/bin/arjun.orig"
elif [ -x "/usr/bin/arjun.orig" ]; then
    REAL_BIN="/usr/bin/arjun.orig"
fi

if [ -z "$REAL_BIN" ]; then
    echo "Error: arjun.orig not found" >&2
    exit 1
fi

PROXY="${HTTP_PROXY:-${HTTPS_PROXY:-${http_proxy:-${https_proxy:-}}}}"

unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy

if [ -n "$PROXY" ]; then
    has_proxy=false
    for arg in "$@"; do
        case "$arg" in
            -oB*)
                has_proxy=true
                break
                ;;
        esac
    done
    if [ "$has_proxy" = false ]; then
        # arjun expects -oB [BURP_PROXY] (host:port or URL)
        PROXY_CLEAN="${PROXY#*://}" # strip protocol://
        PROXY_CLEAN="${PROXY_CLEAN%%/*}" # strip any trailing path
        exec "$REAL_BIN" -oB "$PROXY_CLEAN" "$@"
    fi
fi

exec "$REAL_BIN" "$@"
