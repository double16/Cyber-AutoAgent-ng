#!/usr/bin/env bash
set -e

# Find original binary
REAL_BIN=""
if [ -x "$(dirname "$0")/wafw00f.orig" ]; then
    REAL_BIN="$(dirname "$0")/wafw00f.orig"
elif command -v wafw00f.orig >/dev/null 2>&1; then
    REAL_BIN="$(command -v wafw00f.orig)"
elif [ -x "/usr/local/bin/wafw00f.orig" ]; then
    REAL_BIN="/usr/local/bin/wafw00f.orig"
elif [ -x "/usr/bin/wafw00f.orig" ]; then
    REAL_BIN="/usr/bin/wafw00f.orig"
fi

if [ -z "$REAL_BIN" ]; then
    echo "Error: wafw00f.orig not found" >&2
    exit 1
fi

PROXY="${http_proxy:-${https_proxy:-${HTTP_PROXY:-${HTTPS_PROXY:-}}}}"

unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy

if [ -n "$PROXY" ]; then
    has_proxy=false
    for arg in "$@"; do
        case "$arg" in
            -p|--proxy*)
                has_proxy=true
                break
                ;;
        esac
    done
    if [ "$has_proxy" = false ]; then
        exec "$REAL_BIN" --proxy "$PROXY" "$@"
    fi
fi

exec "$REAL_BIN" "$@"
