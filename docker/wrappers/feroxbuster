#!/usr/bin/env bash
set -e

# Find original binary
REAL_BIN=""
if [ -x "$(dirname "$0")/feroxbuster.orig" ]; then
    REAL_BIN="$(dirname "$0")/feroxbuster.orig"
elif command -v feroxbuster.orig >/dev/null 2>&1; then
    REAL_BIN="$(command -v feroxbuster.orig)"
elif [ -x "/usr/local/bin/feroxbuster.orig" ]; then
    REAL_BIN="/usr/local/bin/feroxbuster.orig"
elif [ -x "/usr/bin/feroxbuster.orig" ]; then
    REAL_BIN="/usr/bin/feroxbuster.orig"
fi

if [ -z "$REAL_BIN" ]; then
    echo "Error: feroxbuster.orig not found" >&2
    exit 1
fi

PROXY="${http_proxy:-${https_proxy:-${HTTP_PROXY:-${HTTPS_PROXY:-}}}}"

unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy

if [ -n "$PROXY" ]; then
    has_replay=false
    for arg in "$@"; do
        case "$arg" in
            --replay-proxy*|-P|--burp-replay)
                has_replay=true
                break
                ;;
        esac
    done
    if [ "$has_replay" = false ]; then
        exec "$REAL_BIN" --replay-proxy "$PROXY" "$@"
    fi
fi

exec "$REAL_BIN" "$@"
