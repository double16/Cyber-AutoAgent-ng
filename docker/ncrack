#!/usr/bin/env bash
set -e

# Find original binary
REAL_BIN=""
if [ -x "$(dirname "$0")/ncrack.orig" ]; then
    REAL_BIN="$(dirname "$0")/ncrack.orig"
elif command -v ncrack.orig >/dev/null 2>&1; then
    REAL_BIN="$(command -v ncrack.orig)"
elif [ -x "/usr/local/bin/ncrack.orig" ]; then
    REAL_BIN="/usr/local/bin/ncrack.orig"
elif [ -x "/usr/bin/ncrack.orig" ]; then
    REAL_BIN="/usr/bin/ncrack.orig"
fi

if [ -z "$REAL_BIN" ]; then
    echo "Error: ncrack.orig not found" >&2
    exit 1
fi

PROXY="${HTTP_PROXY:-${HTTPS_PROXY:-${http_proxy:-${https_proxy:-}}}}"

unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy

if [ -n "$PROXY" ]; then
    has_proxy=false
    for arg in "$@"; do
        case "$arg" in
            --proxy*)
                has_proxy=true
                break
                ;;
        esac
    done
    if [ "$has_proxy" = false ]; then
        # ncrack expects --proxy <type://proxy:port>
        exec "$REAL_BIN" --proxy "$PROXY" "$@"
    fi
fi

exec "$REAL_BIN" "$@"
